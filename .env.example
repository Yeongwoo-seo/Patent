# 이번 세션에는 서버 연동을 구현하지 않았다(단계 D, docs/DEPLOYMENT.md 참고).
# 아래 변수는 실제 값이 아니라 "다음 세션에서 필요할 변수 이름"만 적어둔 것이다.
# 이 파일 자체는 커밋해도 안전하다 — 실제 비밀 값은 .env(gitignore됨)에 넣는다.

# Supabase (14.3, 19.6)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 서버 전용. 클라이언트 번들에 절대 포함하지 말 것.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (14.3, 22.2)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:example@example.com
